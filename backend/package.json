{
  "name": "cricket-hub-backend",
  "version": "1.0.0",
  "description": "Cricket Hub - Complete Cricket Management Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npx nodemon --watch src --ext ts --exec 'npx ts-node src/server.ts'",
    "build": "npx tsc",
    "start": "node dist/server.js",
    "test": "npx jest --forceExit --detectOpenHandles",
    "test:watch": "npx jest --watch --forceExit --detectOpenHandles",
    "test:coverage": "npx jest --coverage --forceExit --detectOpenHandles",
    "lint": "npx tsc --noEmit"
  },
  "keywords": ["cricket", "scoring", "tournament", "auction"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
